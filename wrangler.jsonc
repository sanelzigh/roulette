{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinicex-roulette",
  "main": "worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinicex-roulette-db",
      "database_id": "e9dcb9e5-9a13-4008-b8f9-0547e90ec674"
    }
  ]
}
